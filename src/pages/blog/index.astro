---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import TaxonomyNav from '../../components/TaxonomyNav.astro';
import { byDate } from '../../lib/site';
const entries = (await getCollection('blog', ({ data }) => !data.draft)).sort(byDate);
---
<BaseLayout title="博客" description="Technical notes on Transformer, VLM, computer vision and AI engineering."><section class="container listing"><p class="eyebrow accent">笔记 / 解释</p><h1>技术文章</h1><p class="listing-lead">记录概念、设计决策与研究思路。</p><TaxonomyNav entries={entries} /><div class="note-list">{entries.map(entry => <BlogCard entry={entry} />)}</div></section></BaseLayout>
