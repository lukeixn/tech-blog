---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { byDate } from '../../lib/site';
const entries = (await getCollection('blog', ({ data }) => !data.draft)).sort(byDate);
const categories = ['Transformer', 'VLM', 'Computer Vision', 'AI Agent', 'Deep Learning', 'Engineering'];
---
<BaseLayout title="Blog" description="Technical notes on Transformer, VLM, computer vision and AI engineering."><section class="container listing"><p class="eyebrow accent">NOTES / EXPLANATIONS</p><h1>Technical notes</h1><p class="listing-lead">Concepts, design decisions and research ideas written for careful reading.</p><div class="category-line" aria-label="Blog categories">{categories.map(category => <span>{category}</span>)}</div><div class="note-list">{entries.map(entry => <BlogCard entry={entry} />)}</div></section></BaseLayout>
