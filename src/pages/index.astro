---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ResearchCard from '../components/ResearchCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BlogCard from '../components/BlogCard.astro';
import { profile, withBase, byDate } from '../lib/site';
const [research, projects, blog] = await Promise.all(['research','projects','blog'].map(name => getCollection(name as 'research' | 'projects' | 'blog', ({data}) => !data.draft)));
const featuredResearch = research.filter(entry => entry.data.featured).sort(byDate).slice(0, 3);
const featuredProjects = projects.filter(entry => entry.data.featured).sort(byDate).slice(0, 3);
const recentNotes = blog.sort(byDate).slice(0, 3);
---
<BaseLayout>
  <section class="hero container">
    <p class="eyebrow accent">{profile.role}</p>
    <h1>{profile.name}<span class="hero-dot">.</span></h1>
    <p class="hero-topics">AI / VLM / Vision Transformer / AI Agent</p>
    <p class="hero-lead">{profile.tagline}<br />{profile.focus}</p>
    <div class="hero-actions"><a class="button primary" href={withBase('/research/')}>研究 <span>↗</span></a><a class="button" href={withBase('/projects/')}>项目 <span>↗</span></a><a class="text-action" href={withBase('/blog/')}>博客 ↗</a>{profile.github && <a class="text-action" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>}<a class="text-action" href={withBase('/resume/')}>简历 ↗</a></div>
    <div class="hero-rule"><span>VISION · LANGUAGE · SYSTEMS</span><span>SCROLL TO EXPLORE ↓</span></div>
  </section>
  <section class="section container" id="featured-research"><div class="section-heading"><div><p class="eyebrow">01 / 研究方向</p><h2>精选研究</h2><p>Questions I am exploring and the experiments behind them.</p></div><a href={withBase('/research/')}>查看全部研究 ↗</a></div><div class="card-grid">{featuredResearch.map(entry => <ResearchCard entry={entry} />)}</div></section>
  <section class="section container" id="featured-projects"><div class="section-heading"><div><p class="eyebrow">02 / 工程项目</p><h2>精选项目</h2><p>Engineering work, prototypes and reproducible systems.</p></div><a href={withBase('/projects/')}>查看全部项目 ↗</a></div><div class="card-grid">{featuredProjects.map(entry => <ProjectCard entry={entry} />)}</div></section>
  <section class="section container" id="latest-notes"><div class="section-heading"><div><p class="eyebrow">03 / 技术文章</p><h2>最新技术文章</h2><p>Working through ideas in vision, transformers and agents.</p></div><a href={withBase('/blog/')}>阅读博客 ↗</a></div><div class="note-list">{recentNotes.map(entry => <BlogCard entry={entry} />)}</div></section>
  <section class="contact-band"><div class="container contact-inner"><div><p class="eyebrow">04 / 联系方式</p><h2>想了解我的工作？</h2><p>Explore the code, read the research notes, or get in touch.</p></div><div class="contact-actions">{profile.github && <a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>}<a href={withBase('/resume/')}>简历 ↗</a>{profile.email ? <a href={`mailto:${profile.email}`}>Contact ↗</a> : <a href={withBase('/about/')}>关于 / 联系 ↗</a>}</div></div></section>
</BaseLayout>
