---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile, withBase } from '../lib/site';
---
<BaseLayout title="About" description="About the person behind this research and engineering portfolio."><section class="container listing about"><p class="eyebrow accent">ABOUT / CONTACT</p><h1>About</h1><p class="listing-lead">{profile.tagline}. {profile.focus}</p><div class="prose prose-wide"><h2>What I work on</h2><p>I study the connection between visual detail, token representations and reliable downstream reasoning. This site collects research questions, engineering projects and technical notes in one place.</p><h2>Get in touch</h2><p>{profile.email ? <a href={`mailto:${profile.email}`}>{profile.email}</a> : 'Add a public email address in src/lib/site.ts to enable contact.'}</p><p><a href={withBase('/projects/')}>Explore projects →</a></p></div></section></BaseLayout>
