---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResearchCard from '../../components/ResearchCard.astro';
import { byDate } from '../../lib/site';
const entries = (await getCollection('research', ({ data }) => !data.draft)).sort(byDate);
---
<BaseLayout title="研究" description="Research directions and experiments in vision and VLM."><section class="container listing"><p class="eyebrow accent">问题 / 实验</p><h1>研究</h1><p class="listing-lead">Current directions, hypotheses and experimental plans. Results are added only when verified.</p><div class="card-grid">{entries.map(entry => <ResearchCard entry={entry} />)}</div></section></BaseLayout>
